# Firebase Configuration for Phase 5: Backend Integration
# Copy this file to .env.local and fill in your Firebase project credentials
# Get these values from Firebase Console: https://console.firebase.google.com

# API Key - Public key for initializing Firebase
REACT_APP_FIREBASE_API_KEY=your_api_key_here

# Auth Domain - Your Firebase auth domain
REACT_APP_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

# Project ID - Your Firebase project ID
REACT_APP_FIREBASE_PROJECT_ID=your_project_id

# Storage Bucket - Your Firebase storage bucket
REACT_APP_FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Messaging Sender ID - Firebase messaging sender ID
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# App ID - Firebase app ID
REACT_APP_FIREBASE_APP_ID=your_app_id

# === SETUP INSTRUCTIONS ===
# 1. Go to https://console.firebase.google.com
# 2. Create a new Firebase project (or use existing)
# 3. Create a web app in the project
# 4. Copy the credentials shown during app creation
# 5. Paste them into the corresponding env variables above
# 6. Rename this file to .env.local
# 7. For production (Vercel), add these same variables to Vercel Settings > Environment Variables
#
# === FIREBASE SETUP CHECKLIST ===
# [ ] Firestore Database created (with default rules for development)
# [ ] Storage bucket enabled
# [ ] Web app created with credentials
# [ ] .env.local created with all credentials filled
# [ ] Firestore rules updated for production before deploying
#
# === DEFAULT FIRESTORE RULES (Development) ===
# rules_version = '2';
# service cloud.firestore {
#   match /databases/{database}/documents {
#     match /cards/{document=**} {
#       allow read, write: if true;
#     }
#   }
# }
#
# === DEFAULT STORAGE RULES (Development) ===
# rules_version = '2';
# service firebase.storage {
#   match /b/{bucket}/o {
#     match /cards/{allPaths=**} {
#       allow read, write: if true;
#     }
#   }
# }
#
# === PRODUCTION RULES ===
# Update these rules before deploying to production!
# You'll need to implement proper authentication and authorization.
